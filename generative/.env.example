# Required: where generated notes are written (your Obsidian vault).
# Use an absolute path for your OS:
#   macOS/Linux:  /Users/you/ObsidianVault   or   /home/you/ObsidianVault
#   Windows:      C:/Users/you/ObsidianVault
ATOMIC_AGENT_VAULT_PATH=/path/to/your/ObsidianVault

# Optional: base folder for source PDFs (same path rules as above).
ATOMIC_AGENT_PDF_BASE=/path/to/your/Literatur

# Optional: contact identifier written into note provenance (leave as-is if unsure).
ATOMIC_AGENT_CONTACT=your-email@example.com

# Backend: subscription (default, Claude Code CLI) | litellm (API-based)
ATOMIC_AGENT_BACKEND=subscription

# Maintainer conveniences (default off): auto version bump + dashboard autostart on :8051.
# ATOMIC_AGENT_MAINTAINER=1

# Model overrides (optional). Leave these commented to use the sane defaults from
# config.py: sonnet for the heavy slot (lower hallucination, cheaper than opus),
# haiku for the light stages. Uncomment only to deliberately override.
#
# ATOMIC_AGENT_MODEL_OPUS is deprecated (#317) — kept as a fallback so existing .env
# files keep working, but new setups should use ATOMIC_AGENT_MODEL_MAIN instead.
# Priority: ATOMIC_AGENT_MODEL_MAIN > ATOMIC_AGENT_MODEL_OPUS (deprecated) > default.
# ATOMIC_AGENT_MODEL_MAIN=anthropic/claude-sonnet-4-6
# ATOMIC_AGENT_MODEL_HAIKU=anthropic/claude-haiku-4-5-20251001

# Eval judge model (generative/eval_quality_v4.py). Defaults to ATOMIC_AGENT_MODEL_MAIN
# if unset — set separately to run the eval judge on a different model than the
# generation pipeline (e.g. for self-preference studies where the judge model matters).
# ATOMIC_AGENT_MODEL_JUDGE=anthropic/claude-sonnet-4-6

# Per-role overrides (optional, rarely needed). Each defaults to
# ATOMIC_AGENT_MODEL_MAIN if unset.
# ATOMIC_AGENT_MODEL_PLANNER=anthropic/claude-sonnet-4-6
# ATOMIC_AGENT_MODEL_EXTRACTOR=anthropic/claude-sonnet-4-6
# ATOMIC_AGENT_MODEL_EXTENDER=anthropic/claude-sonnet-4-6
# ATOMIC_AGENT_MODEL_CANONICALIZER=anthropic/claude-sonnet-4-6

# Provider keys (only needed for ATOMIC_AGENT_BACKEND=litellm)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# OLLAMA_API_BASE=http://localhost:11434   # optional, default already localhost
